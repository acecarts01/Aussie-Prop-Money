# Australian Reserve Props — Vercel environment variables
# Set in Vercel: Project "aussie-prop-money" → Settings → Environment Variables → Production.
# All values below are SERVER-ONLY (no NEXT_PUBLIC_ prefix): they are read by
# src/app/api/send/route.js at request time and never reach the browser.
# Changing a value takes effect on the next deployment.

# ---- Outgoing mail (required — orders, contact and wholesale forms) ----
SMTP_HOST=smtp.zoho.com.au
SMTP_PORT=465
SMTP_USER=info@australianreserveprops.com
SMTP_PASS=                      # Zoho "application-specific password", not the mailbox login
MAIL_FROM=info@australianreserveprops.com

# ---- Inboxes (optional — default to SMTP_USER) ----
ORDER_TO=info@australianreserveprops.com
CONTACT_TO=info@australianreserveprops.com
WHOLESALE_TO=info@australianreserveprops.com

# ---- Payment instructions sent in the customer's order confirmation (optional) ----
# Leave a method blank and the email says "details to follow" for that method instead.
PAYID_ID=                       # e.g. the PayID email or phone number
PAYID_NAME=Money 365 Pty Ltd
BANK_NAME=
BANK_BSB=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=Money 365 Pty Ltd
CRYPTO_BTC=
CRYPTO_USDT=                    # include the network, e.g. "TRC20: T..." or "ERC20: 0x..."
CRYPTO_ETH=
CRYPTO_BNB=
