# Australian Reserve Props — environment variables
# Set these in Vercel: Project "aussie-prop-money" → Settings → Environment Variables (Production).
# All are NEXT_PUBLIC_* because the site is static (no server) — they are inlined at build time,
# so every change needs a redeploy. Never put bank account numbers, PayID details or wallet
# addresses here: they would be published in the client bundle. Payment details are sent by
# email after an order is confirmed.

# Web3Forms access key for the Contact / Order / Wholesale forms (public by design — it only
# identifies the receiving inbox). Create it at https://web3forms.com with info@australianreserveprops.com.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Inboxes. Defaults to info@australianreserveprops.com when unset. Order and wholesale
# addresses are CC'd via Web3Forms when they differ from the contact address.
NEXT_PUBLIC_CONTACT_EMAIL=info@australianreserveprops.com
NEXT_PUBLIC_ORDER_EMAIL=info@australianreserveprops.com
NEXT_PUBLIC_WHOLESALE_EMAIL=info@australianreserveprops.com

# WhatsApp / contact number shown in the footer, contact page and chat hub.
NEXT_PUBLIC_WHATSAPP=+61 480 804 189

# Optional Cloudflare Turnstile site key for the forms (leave blank to disable).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
